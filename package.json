{
  "name": "madrasti",
  "private": true,
  "type": "module",

  "packageManager": "npm@10.8.2",
  "engines": { "node": ">=20 <21", "npm": ">=10 <11" },

  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm -ws run lint",
    "test": "npm -ws run test",
    "build": "npm -ws run build",
    "dev:auth": "npm -w @madrasti/auth-service run dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./run_all.ps1"
  }
}
