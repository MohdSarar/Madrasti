# Global (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

AUTH_PORT=8081
STUDENT_PORT=8082
SCHOOL_PORT=8083
USER_PROFILE_PORT=8084

# Secrets (dev only)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Step 3: protects /internal/* endpoints on auth service
INTERNAL_SERVICE_TOKEN=dev-internal-token


# Step 4: Security Service integration
SECURITY_SERVICE_URL=http://security:8085
SECURITY_SERVICE_TOKEN=change-me-in-prod
