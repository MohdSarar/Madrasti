# =============================================================================
# Madrasti Platform — Environment Variables
# Copy this file to .env and fill in production secrets.
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=madrasti
POSTGRES_PASSWORD=madrasti
POSTGRES_DB=madrasti
POSTGRES_PORT=5432

# Shared database URL (all services share one DB in development)
DATABASE_URL=postgres://madrasti:madrasti@postgres:5432/madrasti

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- Application ---
NODE_ENV=development
APP_VERSION=dev
LOG_LEVEL=info
LOG_PRETTY=1

# --- JWT Secrets (rotate before production — must be >= 32 chars) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production

# --- Service Ports ---
AUTH_PORT=8081
STUDENT_PORT=8082
SCHOOL_PORT=8083
USER_PROFILE_PORT=8084
ACADEMIC_PORT=8085
ATTENDANCE_PORT=8086
SCHEDULING_PORT=8087
REPORTING_PORT=8088
NOTIFICATION_PORT=8089
DOCUMENT_PORT=8090
SECURITY_PORT=8091

# --- Internal Service Auth ---
# Token used for service-to-service calls on /internal/* endpoints
INTERNAL_SERVICE_TOKEN=dev-internal-token

# --- Security Service ---
SECURITY_SERVICE_URL=http://security:8091
SECURITY_SERVICE_TOKEN=change-me-in-prod

# --- Auth Service Token (used by other services to call auth) ---
AUTH_SERVICE_TOKEN=change-me-in-prod

# --- Document Service (S3 / MinIO) ---
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For S3-compatible storage (e.g., MinIO): set the endpoint URL
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Email Verification (Auth Service) ---
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# Set to true ONLY in dev/test to return the token in API response
EXPOSE_EMAIL_VERIFICATION_TOKEN=true
REQUIRE_EMAIL_VERIFIED=false

# --- CORS (Kong Gateway) ---
# Add your frontend production URL here in addition to localhost
CORS_ORIGIN=http://localhost:3000

# --- Trust Proxy ---
# Set to 1 when running behind a reverse proxy (e.g., nginx, Vercel, AWS ALB)
TRUST_PROXY=0
