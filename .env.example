# Global (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

AUTH_PORT=8081
STUDENT_PORT=8082
SCHOOL_PORT=8083
USER_PROFILE_PORT=8084

# Secrets (dev only)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Step 3: protects /internal/* endpoints on auth service
INTERNAL_SERVICE_TOKEN=dev-internal-token


# Step 4: Security Service integration
SECURITY_SERVICE_URL=http://security:8085
SECURITY_SERVICE_TOKEN=change-me-in-prod

# Step 4 services
SECURITY_PORT=8091
ACADEMIC_PORT=8085
ATTENDANCE_PORT=8086
SCHEDULING_PORT=8087
REPORTING_PORT=8088
NOTIFICATION_PORT=8089
DOCUMENT_PORT=8090

# Service tokens (dev only)
AUTH_SERVICE_TOKEN=change-me-in-prod
SECURITY_SERVICE_URL=http://security:${SECURITY_PORT}


# --- Document Service (S3) ---
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional if you support S3-compatible (MinIO)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Step 4 (Auth): email verification
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EXPOSE_EMAIL_VERIFICATION_TOKEN=true
REQUIRE_EMAIL_VERIFIED=false
